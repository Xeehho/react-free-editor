{
  "name": "react-free-editor",
  "version": "1.0.0",
  "description": "A powerful React rich text editor based on tiptap with markdown mode, media upload, and custom blocks support",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "editor",
    "rich-text",
    "tiptap",
    "markdown",
    "antd",
    "upload"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "antd": ">=5.0.0",
    "@ant-design/icons": ">=5.0.0"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-text-align": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "antd": "^6.3.6",
    "cssnano": "^7.1.7",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup": "^4.60.2",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.99.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
